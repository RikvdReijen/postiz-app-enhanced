{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@gitroom/helpers/*": ["../../libraries/helpers/src/*"],
      "@postpls/*": ["src/*"]
    }
  },
  // vite.config.ts is left out: it pulls in @vitejs/plugin-react's types,
  // which use syntax newer than the TypeScript this repo pins. Vite type
  // checks its own config at build time.
  "include": ["src", "capacitor.config.ts"]
}

<?xml version="1.0" encoding="utf-8"?>
<!--
  A self-hosted PostPls usually lives on a LAN address with no certificate at
  all, so cleartext has to be possible. It is scoped to private ranges and to
  localhost rather than opened globally, so a misconfigured public host still
  fails loudly instead of silently downgrading.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">172.16.0.0</domain>
        <domain includeSubdomains="true">postpls.local</domain>
    </domain-config>
</network-security-config>
